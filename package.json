{
  "name": "nagrandhotel",
  "private": true,
  "description": "Nagrand Resort & Spa — React (Vite) web app + Express/MongoDB API",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev:web": "npm run start -w nagrandhotel-web",
    "dev:api": "npm run dev -w nagrandhotel-api",
    "build:web": "npm run build -w nagrandhotel-web",
    "preview:web": "npm run preview -w nagrandhotel-web",
    "start:api": "npm start -w nagrandhotel-api",
    "test:api": "npm test -w nagrandhotel-api"
  },
  "engines": {
    "node": ">=18"
  }
}
